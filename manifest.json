{
  "name": "pdfstage",
  "short_name": "pdfstage",
  "description": "Lokaler PDF-Player mit synchronisiertem Audio, Kapiteln und Volltextsuche",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#111111",
  "theme_color": "#111111",
  "orientation": "any",
  "icons": [
    {
      "src": "./icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/pdf": [".pdf"]
      }
    }
  ]
}
